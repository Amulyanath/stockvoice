# Local demo: in-memory inventory, no MongoDB or Gemini credentials required.
DEMO_MODE=true
HOST=127.0.0.1
PORT=3001
JWT_SECRET=replace-with-a-random-local-secret-at-least-32-characters

# Optional live services. Leave unset for the local demo.
MONGODB_URI=
MONGODB_DB=stockvoice
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
STT_MODEL=gemini-3.5-transcribe
